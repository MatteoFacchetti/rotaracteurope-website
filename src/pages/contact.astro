---
import Base from "../layouts/Base.astro";
import { href } from "../lib/url";
---

<Base
  title="Contact"
  description="Write to the Rotaract Europe board."
>
  <main id="content" class="wrap">
    <header class="page-head">
      <p class="kicker">Contact</p>
      <h1>Write to the board</h1>
    </header>
    <div class="split">
      <div>
        <p class="lede"><a href="mailto:board@rotaracteurope.eu">board@rotaracteurope.eu</a></p>
        <p>Events: <a href="mailto:events@rotaracteurope.eu">events@rotaracteurope.eu</a></p>
        <p>Awards and twin certificates: <a href="mailto:social@rotaracteurope.eu">social@rotaracteurope.eu</a></p>
        <p><a href="https://whatsapp.com/channel/0029VaAMdoqIiRp27TYUt73b">WhatsApp channel</a> for news the board already sends there.</p>
        <p><a href={href("board/")}>The current board</a> is chaired by Elise Nassif. The registered address below is the association, not a walk-in office.</p>
      </div>
      <aside class="panel">
        <h2>Registered address</h2>
        <p>
          Rotaract Europe ASBL<br />
          European Rotaract Information Centre<br />
          61, Val Sainte-Croix<br />
          L-1371 Luxembourg
        </p>
      </aside>
    </div>
  </main>
</Base>
